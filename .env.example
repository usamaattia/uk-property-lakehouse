# Local defaults need no configuration. To change them, export these variables
# (for example with direnv, or `set -a; source .env; set +a`).

# Landing zone: a folder, or a Unity Catalog Volume (/Volumes/<catalog>/<schema>/<volume>)
LANDING_URI=data/landing
# dbt target: dev (DuckDB), databricks, or spark (local Spark, for the parity check)
DBT_TARGET=dev
DUCKDB_PATH=warehouse/lakehouse.duckdb

# Databricks (only for DBT_TARGET=databricks)
# DATABRICKS_HOST=<workspace>.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>
# DATABRICKS_TOKEN=
# DATABRICKS_CATALOG=workspace
